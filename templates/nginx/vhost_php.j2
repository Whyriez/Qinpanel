# QonPanel - Site Virtual Host (PHP)
# Site ID: {{ site_id }}
# Auto-generated by panel-webserver. Do not edit directly.

{% if force_https and has_ssl %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ primary_domain }}{% for alias in alias_domains %} {{ alias }}{% endfor %};

    include {{ snippets_dir }}/acme.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

server {
    {% if not force_https or not has_ssl %}
    listen 80;
    listen [::]:80;
    {% endif %}
    {% if has_ssl %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    ssl_certificate {{ ssl_cert }};
    ssl_certificate_key {{ ssl_key }};
    {% if ocsp_stapling %}
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;
    {% endif %}
    {% endif %}

    server_name {{ primary_domain }}{% for alias in alias_domains %} {{ alias }}{% endfor %};

    root {{ docroot }};
    index {{ index_files | default("index.php index.html index.htm", true) }};

    access_log {{ log_dir }}/access.log panel_json;
    error_log {{ log_dir }}/error.log warn;

    client_max_body_size {{ upload_max_size | default("64M", true) }};

    include {{ snippets_dir }}/acme.conf;
    include {{ snippets_dir }}/security-headers.conf;
    include {{ snippets_dir }}/deny-sensitive.conf;
    {% if site_rules_block %}
    {{ site_rules_block | safe }}
    {% else %}
    {{ qpanel_default_error_page | safe }}
    {% endif %}

    # Sensitive application and dependency files protection
    location ~* /(?:\.(?!well-known)|composer\.(?:json|lock)|package(?:\-lock)?\.json|yarn\.lock|\.env|\.user\.ini|web\.config) {
        deny all;
        access_log off;
        log_not_found off;
    }

    {% if custom_headers %}
    # Custom Headers
    {% for header in custom_headers %}
    add_header {{ header.name }} "{{ header.value }}" always;
    {% endfor %}
    {% endif %}

    {% if preset == "wordpress" %}
    # WordPress: Deny direct execution of PHP files in uploads
    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # WordPress: Deny direct execution in wp-includes
    location ~* ^/wp-includes/.*\.php$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # WordPress: Protect configuration and metadata
    location = /wp-config.php {
        deny all;
        access_log off;
        log_not_found off;
    }
    location ~* /(?:readme|license)\.(?:html|txt)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # WordPress: Static uploads, themes, and plugins caching
    location ~* ^/wp-content/.*\.(?:css|js|jpe?g|gif|png|webp|avif|ico|svg|woff2?|ttf|eot)$ {
        expires max;
        log_not_found off;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    {% elif preset == "laravel" %}
    # Laravel: Protect internal storage and logging
    location ~* ^/storage/logs/ {
        deny all;
        access_log off;
        log_not_found off;
    }
    {% endif %}

    # General static assets caching
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2|ttf|eot|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
        log_not_found off;
    }

    # Front-controller handler
    location / {
        {% if preset == "laravel" %}
        try_files $uri $uri/ /index.php?$query_string;
        {% elif preset == "wordpress" %}
        try_files $uri $uri/ /index.php?$args;
        {% elif preset == "custom" %}
        try_files $uri $uri/ /{{ custom_entry_file | default("index.php", true) }}?$args;
        {% else %}
        try_files $uri $uri/ /index.php?$args;
        {% endif %}
    }

    {% if fastcgi_cache and fastcgi_cache.enabled %}
    # FastCGI Microcache bypass conditions
    set $skip_cache 0;
    if ($request_method = POST) {
        set $skip_cache 1;
    }
    if ($query_string != "") {
        set $skip_cache 1;
    }
    # Authenticated cookies & WordPress/PHP session protection
    if ($http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in|PHPSESSID{% for cookie in fastcgi_cache.custom_bypass_cookies %}|{{ cookie }}{% endfor %}") {
        set $skip_cache 1;
    }
    if ($http_authorization) {
        set $skip_cache 1;
    }
    {% endif %}

    # PHP-FPM execution block
    location ~ \.php$ {
        try_files $fastcgi_script_name =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass {{ fpm_socket }};
        fastcgi_index index.php;
        include {{ snippets_dir }}/fastcgi-params.conf;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        {% if fastcgi_cache and fastcgi_cache.enabled %}
        fastcgi_cache {{ fastcgi_cache.zone_name | default("panel_php_cache", true) }};
        fastcgi_cache_valid 200 301 302 {{ fastcgi_cache.valid_time | default("60m", true) }};
        {% if fastcgi_cache.use_stale %}
        fastcgi_cache_use_stale error timeout updating invalid_header http_500 http_503;
        {% endif %}
        fastcgi_cache_bypass $skip_cache;
        fastcgi_no_cache $skip_cache;
        add_header X-FastCGI-Cache $upstream_cache_status;
        {% endif %}
    }
}

{% if redirects %}
# Domain Redirects (Alias / Subdomain / www / non-www / Custom)
{% for redir in redirects %}
server {
    listen 80;
    listen [::]:80;
    {% if has_ssl %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    ssl_certificate {{ ssl_cert }};
    ssl_certificate_key {{ ssl_key }};
    {% endif %}

    server_name {{ redir.domain }};

    include {{ snippets_dir }}/acme.conf;

    location / {
        return {{ redir.status_code }} {{ redir.target }};
    }
}
{% endfor %}
{% endif %}
