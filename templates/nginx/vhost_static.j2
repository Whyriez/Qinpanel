# QonPanel - Site Virtual Host (Static)
# Site ID: {{ site_id }}
# Auto-generated by panel-webserver. Do not edit directly.

{% if force_https and has_ssl %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ primary_domain }}{% for alias in alias_domains %} {{ alias }}{% endfor %};

    include {{ snippets_dir }}/acme.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

server {
    {% if not force_https or not has_ssl %}
    listen 80;
    listen [::]:80;
    {% endif %}
    {% if has_ssl %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    ssl_certificate {{ ssl_cert }};
    ssl_certificate_key {{ ssl_key }};
    {% endif %}

    server_name {{ primary_domain }}{% for alias in alias_domains %} {{ alias }}{% endfor %};

    root {{ docroot }};
    index {{ index_files | default("index.html index.htm", true) }};

    access_log {{ log_dir }}/access.log panel_json;
    error_log {{ log_dir }}/error.log warn;

    include {{ snippets_dir }}/acme.conf;
    include {{ snippets_dir }}/security-headers.conf;
    include {{ snippets_dir }}/deny-sensitive.conf;
    disable_symlinks if_not_owner;
    {% if site_rules_block %}
    {{ site_rules_block | safe }}
    {% else %}
    {{ qpanel_default_error_page | safe }}
    {% endif %}

    {% if custom_headers %}
    # Custom Headers
    {% for header in custom_headers %}
    add_header {{ header.name }} "{{ header.value }}" always;
    {% endfor %}
    {% endif %}

    # Static assets caching
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
        log_not_found off;
    }

    # Primary location handler
    location / {
        {% if spa_fallback %}
        try_files $uri $uri/ /index.html;
        {% else %}
        try_files $uri $uri/ =404;
        {% endif %}
    }
}
